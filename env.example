# ==============================================================================
# ProtonVPN WireGuard Configuration
# ==============================================================================
# Generate at: https://account.protonvpn.com/downloads#wireguard-configuration
#
# On that page you choose: country, Secure Core, NetShield level, and
# VPN Accelerator BEFORE generating. Those settings are baked into the key
# and cannot be changed at runtime — regenerate to change them.
#
# From the generated config, copy these values:
#
#   [Interface]
#   PrivateKey = <copy to WG_PRIVATE_KEY>
#   Address    = <copy to WG_ADDRESS>
#   DNS        = <copy to WG_DNS>
#
#   [Peer]
#   PublicKey  = <copy to WG_PEER_PUBLIC_KEY>
#   Endpoint   = <copy to WG_ENDPOINT>

WG_PRIVATE_KEY=
WG_PEER_PUBLIC_KEY=
WG_ENDPOINT=
WG_ADDRESS=10.2.0.2/32
WG_DNS=10.2.0.1

# ==============================================================================
# Kill Switch
# ==============================================================================
# When enabled, ALL traffic is blocked if the WireGuard tunnel drops.
# Uses prohibit routes (same approach as protonwire) — not firewall rules.
# LAN, link-local, and Tailscale (CGNAT 100.64.0.0/10) remain reachable.
KILL_SWITCH=true

# ==============================================================================
# Tailscale
# ==============================================================================
# Generate auth key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=proton-exit
# Optional: extra flags (e.g. --advertise-tags=tag:vpn --accept-dns=false)
TS_EXTRA_ARGS=
