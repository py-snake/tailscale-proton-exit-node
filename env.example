# ==============================================================================
# Cloudflare WARP
# ==============================================================================
# WARP credentials are AUTO-GENERATED by wgcf-init (run once:
#   podman compose up wgcf-init
# which writes ./warp/.env.warp, mounted read-only at /warp/.env.warp).
# No manual WARP values are needed here. To rotate the WARP identity or
# re-resolve the endpoint, re-run wgcf-init and restart the container.

# ==============================================================================
# Kill Switch
# ==============================================================================
# When enabled, ALL traffic is blocked if the WARP tunnel drops.
# Uses prohibit routes (same approach as protonwire) — not firewall rules.
# LAN, link-local, and Tailscale (CGNAT 100.64.0.0/10) remain reachable.
KILL_SWITCH=true

# ==============================================================================
# Tailscale
# ==============================================================================
# Generate auth key at: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=tailscale-warp
# Optional: extra flags (e.g. --advertise-tags=tag:vpn --accept-dns=false)
TS_EXTRA_ARGS=--accept-dns=false

# ==============================================================================
# Watchdog
# ==============================================================================
# Seconds after which a stale WireGuard handshake triggers a tunnel recycle.
WATCHDOG_HANDSHAKE_MAX_AGE=180